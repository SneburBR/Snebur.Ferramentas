{
  "$schema": "http://json-schema.org/draft-04/schema",
  "title": "Publicação Extensão Snebur",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "caminhoPulicacao": {
      "type": "string",
      "description": "Caminho local ou rede onde os arquivos ser�o publicados."
    },
    "nomeLib": {
      "type": "string",
      "description": "Nome da lib."
    },
    "nomePastaBuild": {
      "type": [ "string", "null" ],
      "description": "Nome da pasta"
    },
    "isCriarPastaVersao": {
      "type": "boolean"
    },
    "isZiparBin": {
      "type": "boolean"
    },
    "isCopiarSource": {
      "type": "boolean"
    },
    "builds": {
      "type": "array",
      "description": "Caminho dos arquivos (compilados js ou css)",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "arquivosWeb": {
      "type": "array",
      "description": "Caminho dos arquivos (web)",
      "items": {
        "type": "string"
      }
    },
    "arquivosBin": {
      "type": "array",
      "description": "Caminho dos arquivos /bin",
      "items": {
        "type": "string"
      }
    },
    "caminhosCompilacao": {
      "type": "array",
      "description": "i.g net48, net6.0, net8.0",
      "items": {
        "type": "string",
        "enum": [
          "net45",
          "net48",
          "net6.0",
          "net8.0"
        ]
      }
    },
    "caminhoCompilacao": {
      "type": "string",
      "description": "i.g net48, net6.0, net8.0",
      "enum": [ "net462", "net48", "net6.0", "net8.0" ]
    },
    "executarProcessoDepois": { "type": "string" },
    "buildJsOptions": {
      "type": "object",
      "properties": {
        "nomeArquivo": { "type": "string" },
        "nomeArquivoZip": { "type": "string" },
        "isUnir": { "type": "boolean" },
        "isEncapsular": { "type": "boolean" },
        "isZipar": { "type": "boolean" },
        "isTeste": { "type": "boolean" },
        "isLibZipAsync": { "type": "boolean" }
      },
      "required": [ "nomeArquivo" ]
    },
    "ignorarArquivos": {
      "type": "array",
      "description": "Arquivos serão ignorar",
      "items": {
        "type": "string"
      }
    },
    "ignorarArquivosRelease": {
      "type": "array",
      "description": "Arquivos serão ignorar",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [ "caminhoPulicacao" ],
  "additionalProperties": false,
  "additionalItems": false

}
